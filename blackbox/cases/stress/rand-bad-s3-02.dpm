data Nat : U where zero : Nat; suc : (n : Nat) -> Nat;
let plus : Nat -> Nat -> Nat =
  λ m n . elim Nat (λ _ . Nat) n (λ _ r . suc r) m;
let mult : Nat -> Nat -> Nat =
  λ m n . elim Nat (λ _ . Nat) zero (λ _ r . plus n r) m;
plus (mult (plus (plus (zero) (suc (suc zero))) (mult (zero) (suc (suc (suc zero))))) (plus (mult (suc (suc zero)) (zero)) (suc (suc zero)))) (suc (suc zero)) (suc (suc (suc zero)))
