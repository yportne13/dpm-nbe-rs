data Nat : U where zero : Nat; suc : (n : Nat) -> Nat;
let plus : Nat -> Nat -> Nat =
  λ m n . elim Nat (λ _ . Nat) n (λ _ r . suc r) m;
let mult : Nat -> Nat -> Nat =
  λ m n . elim Nat (λ _ . Nat) zero (λ _ r . plus n r) m;
plus (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))) (mult (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))))) (mult (suc (plus (zero) (suc zero))) (zero)))
