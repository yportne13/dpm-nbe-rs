-- conversion is reflexive on stuck eliminators: pred n is stuck on the
-- neutral n, yet refl proves pred n = pred n (the printed type shows
-- both stuck elims)
data Nat : U where zero : Nat; suc : Nat -> Nat;
let pred : Nat -> Nat = \ n . elim Nat (\ _ . Nat) zero (\ m r . m) n;
let q : (n : Nat) -> Id Nat (pred n) (pred n) = \ n . refl;
q
