-- chained field projections l.start.py / l.end.px across two struct types
data Nat : U where zero : Nat; suc : Nat -> Nat;
let plus : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) b (\ n r . suc r) a;
struct Pt : U where px : Nat; py : Nat;
struct Ln : U where start : Pt; end : Pt;
let l : Ln = mkLn (mkPt zero (suc zero)) (mkPt (suc (suc zero)) zero);
plus l.start.py l.end.px
