-- large closed computation: 3^5 = 243 as a Peano numeral
-- (expected .out produced by gen.mjs, independently of the binary)
data Nat : U where zero : Nat; suc : Nat -> Nat;
let plus : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) b (\ n r . suc r) a;
let mult : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) zero (\ m r . plus b r) a;
let pow : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) (suc zero) (\ m r . mult a r) b;
pow (suc (suc (suc zero))) (suc (suc (suc (suc (suc zero)))))
