-- Fibonacci by iterating a Pair of consecutive values: fib 15 = 610
-- (expected .out produced by gen.mjs, independently of the binary)
data Nat : U where zero : Nat; suc : Nat -> Nat;
let plus : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) b (\ n r . suc r) a;
struct Pair : U where fst : Nat; snd : Nat;
let step : Pair -> Pair = \ p . mkPair p.snd (plus p.fst p.snd);
let go : Nat -> Pair = elim Nat (\ _ . Pair) (mkPair zero (suc zero)) (\ n r . step r);
let fib : Nat -> Nat = \ n . (go n).fst;
fib (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero)))))))))))))))
