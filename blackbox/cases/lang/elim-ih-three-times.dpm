-- the suc-method uses its induction hypothesis three times: starting from 1,
-- each step triples, so three steps give 3^3 = 27
data Nat : U where zero : Nat; suc : Nat -> Nat;
let plus : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) b (\ n r . suc r) a;
elim Nat (\ _ . Nat) (suc zero) (\ n r . plus r (plus r r)) (suc (suc (suc zero)))
