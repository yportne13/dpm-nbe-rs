-- congruence applied at a computed function: double applied to 2
data Nat : U where zero : Nat; suc : Nat -> Nat;
let plus : Nat -> Nat -> Nat =
  \ a b . elim Nat (\ _ . Nat) b (\ n r . suc r) a;
let cong : (A B : U) (f : A -> B) (a b : A) -> Id A a b -> Id B (f a) (f b) =
  \ A B f a b refl . refl;
cong Nat Nat (\ x . plus x x) (suc (suc zero)) (suc (suc zero)) refl
