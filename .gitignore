# 构建产物
/target/

# 评审/测试的原始证据（体积大或数量多，都可由本仓库中保留的脚本重新生成）
# 报告本身（*.md、*.json、*.csv、*.ps1、*.py、seeds/*.txt）是保留的。
/reviews/robustness/artifacts/
/reviews/robustness/fuzz/
/reviews/blackbox-2/bin/
/reviews/blackbox-2/corpus/
/reviews/blackbox-2/logs/
/reviews/blackbox-2/logs_live/
/reviews/blackbox-2/fuzz/
/reviews/blackbox-2/*.jsonl

# 黑盒测试的可再生产物（日志由 run.sh 重建；fuzz 复现输入按 blackbox/README
# 的约定分流进 cases/ 或 .skip 停放后即删除，不作为原始语料提交）
/blackbox/logs/
/blackbox/fuzz-corpus/

# 语言服务器 / 网页版 / 编辑器扩展的构建产物
# （源码都在仓库里：lsp/、web/api/、web/www/、vscode/client/src、
#   vscode/syntaxes；下面这些全部由 `node web/build.mjs` 与
#   `node vscode/scripts/build.mjs` 重新生成）
/web/www/pkg/
/web/api/*/target/
/web/api/*/pkg/
/vscode/media/
/vscode/client/node_modules/
/vscode/client/dist/
/vscode/*.vsix
